---
layout: null
permalink: /api/graph.json
---
{% assign all_nodes = site.nodes %}
{% assign settings = site.data.settings %}
{
  "settings": {{ settings | jsonify }},
  "nodes": [
    {% for node in all_nodes %}
      
      {% capture node_news %}
        {% assign rel_posts = site.posts | where_exp: "post", "post.related_nodes contains node.slug" %}
        {% if rel_posts.size > 0 %}
          <br><hr>
          <h4>İlgili Gelişmeler</h4>
          <ul style="margin-left:20px; font-size:14px; padding-left: 10px;">
          {% for post in rel_posts %}
            <li style="margin-bottom: 8px;">
              <a href="{{ post.url | relative_url }}" target="_blank" style="color: #38bdf8; text-decoration: none;">
                {{ post.title }}
              </a>
            </li>
          {% endfor %}
          </ul>
        {% endif %}
      {% endcapture %}

      {
        "data": {
          "id": {{ node.slug | jsonify }},
          "label": {{ node.title | default: node.slug | jsonify }},
          "type": {{ node.type | default: "generic" | jsonify }},
          "color": {{ node.color | default: "" | jsonify }},
          "image": {{ node.image | default: "" | jsonify }},
          "size_mode": {{ node.size_mode | default: "auto" | jsonify }},
          "url": {{ node.url | relative_url | jsonify }},
          "content": {{ node.content | append: node_news | jsonify }}
        }
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "edges": [
    {% assign edge_list = "" | split: "" %}
    {% for node in all_nodes %}
      {% if node.relations %}
        {% for rel in node.relations %}
          {% if rel.targets %}
            {% for t in rel.targets %}
              {% capture edge_item %}
                {
                  "data": {
                    "source": {{ node.slug | jsonify }},
                    "target": {{ t | jsonify }},
                    "label": {{ rel.type | default: "" | jsonify }},
                    "weight": {{ rel.weight | default: 1 | jsonify }},
                    "evidence": {{ rel.evidence | default: "belgeli" | jsonify }},
                    "direction": {{ rel.direction | default: "auto" | jsonify }},
                    "edge_color": {{ rel.edge_color | default: "" | jsonify }},
                    "start_date": {{ rel.start_date | default: "" | jsonify }},
                    "end_date": {{ rel.end_date | default: "" | jsonify }}
                  }
                }
              {% endcapture %}
              {% assign edge_list = edge_list | push: edge_item %}
            {% endfor %}
          {% elsif rel.target %}
            {% capture edge_item %}
              {
                "data": {
                  "source": {{ node.slug | jsonify }},
                  "target": {{ rel.target | jsonify }},
                  "label": {{ rel.type | default: "" | jsonify }},
                  "weight": {{ rel.weight | default: 1 | jsonify }},
                  "evidence": {{ rel.evidence | default: "belgeli" | jsonify }},
                  "direction": {{ rel.direction | default: "auto" | jsonify }},
                  "edge_color": {{ rel.edge_color | default: "" | jsonify }},
                  "start_date": {{ rel.start_date | default: "" | jsonify }},
                  "end_date": {{ rel.end_date | default: "" | jsonify }}
                }
              }
            {% endcapture %}
            {% assign edge_list = edge_list | push: edge_item %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
    {{ edge_list | join: "," }}
  ]
}